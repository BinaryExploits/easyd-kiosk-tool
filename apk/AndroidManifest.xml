<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.easyd.kiosk"
    android:versionCode="3"
    android:versionName="1.0.3">

    <uses-sdk android:minSdkVersion="30" android:targetSdkVersion="34" />

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <!-- Android 11+ package visibility: lets us see and launch any launchable app (the chosen target). -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:label="@string/app_name"
        android:icon="@drawable/icon"
        android:banner="@drawable/banner"
        android:allowBackup="false"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar.Fullscreen">

        <activity
            android:name=".KioskActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:clearTaskOnLaunch="true"
            android:excludeFromRecents="true"
            android:resumeWhilePausing="true"
            android:screenOrientation="unspecified"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|uiMode|density" />

        <!-- The HOME entry point. Disabled until a target app is configured, so installing the APK
             alone never changes the device's home screen. Enabled by ConfigReceiver (SET_TARGET). -->
        <activity-alias
            android:name=".HomeAlias"
            android:targetActivity=".KioskActivity"
            android:enabled="false"
            android:exported="true">
            <intent-filter android:priority="1">
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Configuration over adb only: senders must hold android.permission.DUMP, which the adb
             shell has and normal apps cannot get. -->
        <receiver
            android:name=".ConfigReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="com.easyd.kiosk.SET_TARGET" />
                <action android:name="com.easyd.kiosk.GET_TARGET" />
                <action android:name="com.easyd.kiosk.LIST_APPS" />
                <action android:name="com.easyd.kiosk.DISABLE_HOME" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
