<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>KioskManager</AssemblyName>
    <RootNamespace>EasyDKiosk</RootNamespace>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
    <InvariantGlobalization>true</InvariantGlobalization>
    <Version>1.0.2</Version>
    <Product>Kiosk Manager</Product>
    <Company>EasyDisplay</Company>
    <Description>Turns an Android TV device into an EasyD Player kiosk</Description>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="payload\EasyDKiosk.apk" LogicalName="EasyDKiosk.apk" />
    <EmbeddedResource Include="payload\platform-tools-latest-windows.zip" LogicalName="platform-tools.zip" />
  </ItemGroup>
</Project>
